{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoiyu915-droid/EvidenceRadar-Editions/config/schemas/collection.schema.json",
  "title": "EvidenceRadar Editions collection profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "issns", "default_sources"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "issns": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[0-9X]$"},
      "uniqueItems": true
    },
    "publisher": {"type": "string"},
    "default_sources": {
      "type": "array",
      "items": {"enum": ["pubmed", "europe_pmc", "crossref"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "include_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "exclude_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "language": {"type": "string", "minLength": 2}
  }
}
